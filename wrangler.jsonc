{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sideshow",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" }
  },

  "assets": {
    "binding": "ASSETS",
    // Any unknown path falls through to the SPA, so /h/ABCD and /j/ABCD work
    // on a hard refresh.
    "not_found_handling": "single-page-application",
    // API and WebSocket routes must reach the Worker before the asset handler.
    "run_worker_first": ["/api/*", "/parties/*"]
  },

  // Best-effort edge guardrails. Exact per-room limits live in the Durable
  // Object because these counters are intentionally permissive and regional.
  "ratelimits": [
    {
      "name": "ROOM_CREATION_RATE_LIMITER",
      "namespace_id": "73101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "CONNECTION_RATE_LIMITER",
      "namespace_id": "73102",
      "simple": { "limit": 120, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
